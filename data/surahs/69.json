                       "arabic":  "وَانْشَقَّتِ السَّمَٓاءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌۙ",
                       "meal":  "Gök de yarılır ve artık o gün o, çökmeye yüz tutar.",
                       "page":  566,
                       "juz":  29
                   },
                   {
