                       "verseNumber":  23,
                       "arabic":  "اِلٰى رَبِّهَا نَاظِرَةٌۚ",
                       "meal":  "Rablerine bakacaklardır (O\u0027nu göreceklerdir).",
                       "page":  577,
                       "juz":  29
                   },
                   {
