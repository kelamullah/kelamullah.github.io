                       "arabic":  "كَلَّٓا اِذَا بَلَغَتِ التَّرَاقِىَۙ",
                       "meal":  "Artık gözünüzü açın! Ne zaman ki can köprücük kemiğine dayanır,",
                       "page":  577,
                       "juz":  29
                   },
                   {
                       "id":  5654,
                       "verseNumber":  27,
                       "arabic":  "وَقٖيلَ مَنْ۔ رَاقٍۙ",
                       "meal":  "«Tedavi edebilecek kimdir?» denir.",
                       "page":  577,
                       "juz":  29
                   },
                   {
