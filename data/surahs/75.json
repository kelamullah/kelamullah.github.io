                  "nameEn":  "Al-Qiyamah"
              },
    "verses":  [
                   {
                       "id":  5628,
                       "verseNumber":  1,
                       "arabic":  "لَٓا اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ",
                       "meal":  "Kıyamet gününe yemin ederim.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5629,
                       "verseNumber":  2,
                       "arabic":  "وَلَٓا اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ",
                       "meal":  "Kendini kınayan (pişmanlık duyan) nefse yemin ederim (diriltilip hesaba çekileceksiniz).",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5630,
                       "verseNumber":  3,
                       "arabic":  "اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَجْمَعَ عِظَامَهُۜ",
                       "meal":  "İnsan, kendisinin kemiklerini biraraya toplayamayacağımızı mı sanır?",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5631,
                       "verseNumber":  4,
                       "arabic":  "بَلٰى قَادِرٖينَ عَلٰٓى اَنْ نُسَوِّىَ بَنَانَهُ",
                       "meal":  "Evet, bizim, onun parmak uçlarını bile aynen eski haline getirmeye gücümüz yeter.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5632,
                       "verseNumber":  5,
                       "arabic":  "بَلْ يُرٖيدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهُۚ",
                       "meal":  "Fakat insan önündekini (kıyameti) yalanlamak ister.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5633,
                       "verseNumber":  6,
                       "arabic":  "يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۜ",
                       "meal":  "«Kıyamet günü ne zamanmış?» diye sorar.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5634,
                       "verseNumber":  7,
                       "arabic":  "فَاِذَا بَرِقَ الْبَصَرُۙ",
                       "meal":  "İşte, göz kamaştığı, ay tutulduğu, güneşle ay biraraya getirildiği zaman!",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5635,
                       "verseNumber":  8,
                       "arabic":  "وَخَسَفَ الْقَمَرُۙ",
                       "meal":  "İşte, göz kamaştığı, ay tutulduğu, güneşle ay biraraya getirildiği zaman!",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5636,
                       "verseNumber":  9,
                       "arabic":  "وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ",
                       "meal":  "İşte, göz kamaştığı, ay tutulduğu, güneşle ay biraraya getirildiği zaman!",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5637,
                       "verseNumber":  10,
                       "arabic":  "يَقُولُ الْاِنْسَانُ يَوْمَئِذٍ اَيْنَ الْمَفَرُّۚ",
                       "meal":  "O gün insan, «Kaçacak yer neresi!» diyecektir.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5638,
                       "verseNumber":  11,
                       "arabic":  "كَلَّا لَا وَزَرَۚ",
                       "meal":  "Hayır, hayır! (Kaçıp) sığınacak yer yoktur!",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5639,
                       "verseNumber":  12,
                       "arabic":  "اِلٰى رَبِّكَ يَوْمَئِذٍۨ الْمُسْتَقَرُّۜ",
                       "meal":  "O gün varıp durulacak yer, sadece Rabbinin huzurudur.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5640,
                       "verseNumber":  13,
                       "arabic":  "يُنَبَّؤُا الْاِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَاَخَّرَۜ",
                       "meal":  "O gün insana, ileri götürdüğü ve geri bıraktığı ne varsa bildirilir.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5641,
                       "verseNumber":  14,
                       "arabic":  "بَلِ الْاِنْسَانُ عَلٰى نَفْسِهٖ بَصٖيرَةٌۙ",
                       "meal":  "Artık insan, kendi kendinin şahididir.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5642,
                       "verseNumber":  15,
                       "arabic":  "وَلَوْ اَلْقٰى مَعَاذ۪يرَهُۜ",
                       "meal":  "İsterse özürlerini sayıp döksün.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5643,
                       "verseNumber":  16,
                       "arabic":  "لَا تُحَرِّكْ بِهٖ لِسَانَكَ لِتَعْجَلَ بِهٖۜ",
                       "meal":  "(Resûlüm!) onu (vahyi) çarçabuk almak için dilini kımıldatma.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5644,
                       "verseNumber":  17,
                       "arabic":  "اِنَّ عَلَيْنَا جَمْعَهُ وَقُرْاٰنَهُۚ",
                       "meal":  "Şüphesiz onu, toplamak (senin kalbine yerleştirmek) ve onu okutmak bize aittir.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5645,
                       "verseNumber":  18,
                       "arabic":  "فَاِذَا قَرَاْنَاهُ فَاتَّبِعْ قُرْاٰنَهُۚ",
                       "meal":  "O halde, biz onu okuduğumuz zaman, sen onun okunuşunu takip et.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5646,
                       "verseNumber":  19,
                       "arabic":  "ثُمَّ اِنَّ عَلَيْنَا بَيَانَهُۜ",
                       "meal":  "Sonra şüphen olmasın ki, onu açıklamak da bize aittir.",
                       "page":  576,
                       "juz":  29
                   },
                   {
                       "id":  5647,
                       "verseNumber":  20,
                       "arabic":  "كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَۙ",
                       "meal":  "Hayır! Doğrusu siz, çarçabuk geçeni (dünya hayatını ve nimetlerini) seviyor, ahireti bırakıyorsunuz.",
                       "page":  577,
                       "juz":  29
                   },
                   {
                       "id":  5648,
                       "verseNumber":  21,
                       "arabic":  "وَتَذَرُونَ الْاٰخِرَةَۜ",
                       "meal":  "Hayır! Doğrusu siz, çarçabuk geçeni (dünya hayatını ve nimetlerini) seviyor, ahireti bırakıyorsunuz.",
                       "page":  577,
                       "juz":  29
                   },
                   {
