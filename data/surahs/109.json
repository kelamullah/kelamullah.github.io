                       "juz":  30
                   },
                   {
                       "id":  6321,
                       "verseNumber":  4,
                       "arabic":  "وَلَٓا اَنَا۬ عَابِدٌ مَا عَبَدْتُمْۙ",
                       "meal":  "Ben de sizin taptıklarınıza asla tapacak değilim.",
                       "page":  603,
                       "juz":  30
                   },
                   {
                       "id":  6322,
                       "verseNumber":  5,
                       "arabic":  "وَلَٓا اَنْتُمْ عَابِدُونَ مَٓا اَعْبُدُۜ",
                       "meal":  "Evet, siz de benim taptığıma tapıyor değilsiniz.",
