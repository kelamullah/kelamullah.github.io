                       "meal":  "Karışımı Tesnîm\u0027dendir.",
                       "page":  588,
                       "juz":  30
                   },
                   {
                       "id":  5960,
                       "verseNumber":  28,
                       "arabic":  "عَيْنًا يَشْرَبُ بِهَا الْمُقَرَّبُونَۜ",
