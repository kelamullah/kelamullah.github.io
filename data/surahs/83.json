    "verses":  [
                   {
                       "id":  5933,
                       "verseNumber":  1,
                       "arabic":  "وَيْلٌ لِلْمُطَفِّفٖينَۙ",
                       "meal":  "İnsanlardan alırken ölçüp tarttıklarında tam, onlara vermek için ölçüp tarttıklarında ise noksan yapan hilekârlara yazıklar olsun!",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5934,
                       "verseNumber":  2,
                       "arabic":  "‏اَلَّذٖينَ اِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَؗ",
                       "meal":  "İnsanlardan alırken ölçüp tarttıklarında tam, onlara vermek için ölçüp tarttıklarında ise noksan yapan hilekârlara yazıklar olsun!",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5935,
                       "verseNumber":  3,
                       "arabic":  "وَاِذَا كَالُوهُمْ اَوْ وَزَنُوهُمْ يُخْسِرُونَۜ",
                       "meal":  "İnsanlardan alırken ölçüp tarttıklarında tam, onlara vermek için ölçüp tarttıklarında ise noksan yapan hilekârlara yazıklar olsun!",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5936,
                       "verseNumber":  4,
                       "arabic":  "اَلَا يَظُنُّ اُو۬لٰٓئِكَ اَنَّهُمْ مَبْعُوثُونَۙ",
                       "meal":  "Onlar düşünmezler mi ki, büyük bir günde (hesap vermek için) diriltilecekler! Öyle bir gün ki, insanlar o günde âlemlerin Rabbinin huzurunda divan duracaklardır.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5937,
                       "verseNumber":  5,
                       "arabic":  "لِيَوْمٍ عَظٖيمٍۙ",
                       "meal":  "Onlar düşünmezler mi ki, büyük bir günde (hesap vermek için) diriltilecekler! Öyle bir gün ki, insanlar o günde âlemlerin Rabbinin huzurunda divan duracaklardır.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5938,
                       "verseNumber":  6,
                       "arabic":  "يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَمٖينَۚ",
                       "meal":  "Onlar düşünmezler mi ki, büyük bir günde (hesap vermek için) diriltilecekler! Öyle bir gün ki, insanlar o günde âlemlerin Rabbinin huzurunda divan duracaklardır.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5939,
                       "verseNumber":  7,
                       "arabic":  "كَلَّٓا اِنَّ كِتَابَ الْفُجَّارِ لَفٖى سِجّٖينٍۜ",
                       "meal":  "Doğrusu günahkârların yazısı, muhakkak Siccîn\u0027de olmaktır.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5940,
                       "verseNumber":  8,
                       "arabic":  "وَمَٓا اَدْرٰيكَ مَا سِجّٖينٌۜ",
                       "meal":  "Siccîn nedir, bilir misin?",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5941,
                       "verseNumber":  9,
                       "arabic":  "كِتَابٌ مَرْقُومٌۜ",
                       "meal":  "(O günahkârların yazısı) Amellerin sayılıp yazıldığı bir kitaptır.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5942,
                       "verseNumber":  10,
                       "arabic":  "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبٖينَۙ",
                       "meal":  "O gün vay haline yalancıların!",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5943,
                       "verseNumber":  11,
                       "arabic":  "اَلَّذٖينَ يُكَذِّبُونَ بِيَوْمِ الدّٖينِۜ",
                       "meal":  "Ki onlar, ceza gününü yalan sayarlar.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5944,
                       "verseNumber":  12,
                       "arabic":  "وَمَا يُكَذِّبُ بِهٖٓ اِلَّا كُلُّ مُعْتَدٍ اَثٖيمٍۙ",
                       "meal":  "Onu ancak hükümleri çiğneyen ve günaha dalan kimseler yalanlar.",
                       "page":  587,
                       "juz":  30
                   },
                   {
                       "id":  5945,
                       "verseNumber":  13,
                       "arabic":  "اِذَا تُتْلٰى عَلَيْهِ اٰيَاتُنَا قَالَ اَسَاطٖيرُ الْاَوَّلٖينَۜ",
                       "meal":  "Böyle birine âyetlerimiz okununca «Eskilerin masalları» derdi.",
                       "page":  587,
                       "juz":  30
                   },
                   {
