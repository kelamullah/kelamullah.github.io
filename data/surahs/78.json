                       "arabic":  "وَكَذَّبُوا بِاٰيَاتِنَا كِذَّابًاۜ",
                       "meal":  "Bizim âyetlerimizi yalanladıkça yalanlamışlardı.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5780,
