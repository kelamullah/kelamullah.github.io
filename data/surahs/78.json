    "verses":  [
                   {
                       "id":  5752,
                       "verseNumber":  1,
                       "arabic":  "عَمَّ يَتَسَٓاءَلُونَۚ",
                       "meal":  "Birbirlerine neyi soruyorlar?",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5753,
                       "verseNumber":  2,
                       "arabic":  "عَنِ النَّبَاِ الْعَظٖيمِۙ",
                       "meal":  "(İnanıp inanmamakta) ayrılığa düştükleri büyük haberi mi?",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5754,
                       "verseNumber":  3,
                       "arabic":  "اَلَّذٖى هُمْ فٖيهِ مُخْتَلِفُونَۜ",
                       "meal":  "(İnanıp inanmamakta) ayrılığa düştükleri büyük haberi mi?",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5755,
                       "verseNumber":  4,
                       "arabic":  "كَلَّا سَيَعْلَمُونَۙ",
                       "meal":  "Hayır! Anlayacaklar!",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5756,
                       "verseNumber":  5,
                       "arabic":  "ثُمَّ كَلَّا سَيَعْلَمُونَ",
                       "meal":  "Yine hayır! Onlar anlayacaklar!",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5757,
                       "verseNumber":  6,
                       "arabic":  "اَلَمْ نَجْعَلِ الْاَرْضَ مِهَادًاۙ",
                       "meal":  "Biz yeryüzünü bir döşek, dağları da birer kazık yapmadık mı?",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5758,
                       "verseNumber":  7,
                       "arabic":  "وَالْجِبَالَ اَوْتَادًاۖ",
                       "meal":  "Biz yeryüzünü bir döşek, dağları da birer kazık yapmadık mı?",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5759,
                       "verseNumber":  8,
                       "arabic":  "وَخَلَقْنَاكُمْ اَزْوَاجًاۙ",
                       "meal":  "Sizi çifter çifter yarattık.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5760,
                       "verseNumber":  9,
                       "arabic":  "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًاۙ",
                       "meal":  "Uykunuzu bir dinlenme kıldık.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5761,
                       "verseNumber":  10,
                       "arabic":  "وَجَعَلْنَا الَّيْلَ لِبَاسًاۙ",
                       "meal":  "Geceyi bir örtü yaptık.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5762,
                       "verseNumber":  11,
                       "arabic":  "وَجَعَلْنَا النَّهَارَ مَعَاشًاۖ",
                       "meal":  "Gündüzü de çalışıp kazanma zamanı kıldık.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5763,
                       "verseNumber":  12,
                       "arabic":  "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًاۙ",
                       "meal":  "Üstünüzde yedi kat sağlam göğü bina ettik.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5764,
                       "verseNumber":  13,
                       "arabic":  "وَجَعَلْنَا سِرَاجًا وَهَّاجًاۖ",
                       "meal":  "(Orada) alev alev yanan bir kandil yarattık.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5765,
                       "verseNumber":  14,
                       "arabic":  "وَاَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَٓاءً ثَجَّاجًاۙ",
                       "meal":  "Size tohumlar, bitkiler, (ağaçları) sarmaş dolaş olmuş bağlar bahçeler yetiştirmek için üstüste yığılıp sıkışan bulutlardan şarıl şarıl akan sular indirdik.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5766,
                       "verseNumber":  15,
                       "arabic":  "لِنُخْرِجَ بِهٖ حَبًّا وَنَبَاتًاۙ",
                       "meal":  "Size tohumlar, bitkiler, (ağaçları) sarmaş dolaş olmuş bağlar bahçeler yetiştirmek için üstüste yığılıp sıkışan bulutlardan şarıl şarıl akan sular indirdik.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5767,
                       "verseNumber":  16,
                       "arabic":  "وَجَنَّاتٍ اَلْفَافًاۜ",
                       "meal":  "Size tohumlar, bitkiler, (ağaçları) sarmaş dolaş olmuş bağlar bahçeler yetiştirmek için üstüste yığılıp sıkışan bulutlardan şarıl şarıl akan sular indirdik.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5768,
                       "verseNumber":  17,
                       "arabic":  "اِنَّ يَوْمَ الْفَصْلِ كَانَ مٖيقَاتًاۙ",
                       "meal":  "Şüphesiz hüküm günü vakit olarak belirlenmiştir.",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5769,
                       "verseNumber":  18,
                       "arabic":  "يَوْمَ يُنْفَخُ فِى الصُّورِ فَتَاْتُونَ اَفْوَاجًاۙ",
                       "meal":  "Sûr\u0027a üflendiği gün, bölük bölük Allah\u0027a gelirsiniz#",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5770,
                       "verseNumber":  19,
                       "arabic":  "وَفُتِحَتِ السَّمَٓاءُ فَكَانَتْ اَبْوَابًاۙ",
                       "meal":  "Gökyüzü açılır ve orada pek çok kapılar oluşur#",
                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5771,
