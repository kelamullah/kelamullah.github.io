                       "page":  581,
                       "juz":  30
                   },
                   {
                       "id":  5772,
                       "verseNumber":  21,
                       "arabic":  "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًاۙ",
                       "meal":  "Şüphesiz, azgınların barınağı olacak cehennem pusuda beklemektedir.",
                       "page":  581,
                       "juz":  30
                   },
                   {
